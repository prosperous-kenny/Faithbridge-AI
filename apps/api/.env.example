FAITHBRIDGE_ENV=development
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8200
DATABASE_URL=postgresql+asyncpg://faithbridge:change_me@localhost:5432/faithbridge
DB_ECHO=false

# Notifications (Phase 2). Resend requires a real key; requests without one
# return HTTP 401 missing_api_key. Free tier: 3,000 emails/month.
RESEND_API_KEY=
EMAIL_FROM=FaithBridge AI <notifications@yourdomain.com>